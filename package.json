{
  "name": "tekstil-erp",
  "version": "1.0.17",
  "private": true,
  "description": "Simteks Tekstil ERP — masaüstü (ortak veritabanı)",
  "author": "Simteks Tekstil",
  "scripts": {
    "start": "npx --yes serve . -p 3000",
    "preview": "npx --yes serve . -p 3000",
    "desktop": "electron .",
    "build:win": "node scripts/restore-prod-build.js && electron-builder --win nsis",
    "build:dir": "node scripts/restore-prod-build.js && electron-builder --win dir",
    "publish": "node scripts/publish-unified-update.js",
    "publish:content": "node scripts/publish-content-update.js",
    "bump": "node scripts/bump-version.js",
    "mobil:www": "node scripts/build-mobil-app.js",
    "mobil:android": "node scripts/build-mobil-app.js && cd mobile-app && npm install && npx cap sync android",
    "mobil:ios": "node scripts/build-mobil-app.js && cd mobile-app && npm install && npx cap sync ios"
  },
  "main": "electron/main.js",
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.simteks.tekstil.erp",
    "productName": "Simteks Tekstil ERP",
    "files": [
      "stok.html",
      "index.html",
      "erp-build.js",
      "erp-config.js",
      "erp-config.sample.js",
      "assets/**/*",
      "electron/**/*",
      "skins/**/*",
      "package.json",
      "!**/*.exe",
      "!**/*.blockmap",
      "!sunucuya-at{,/**}",
      "!sunucuya-at-mobil{,/**}",
      "!supabase{,/**}",
      "!scripts{,/**}",
      "!releases{,/**}",
      "!dist{,/**}",
      "!dist-deneme{,/**}",
      "!mobil-erp.html",
      "!mobil-erp.standalone.html",
      "!node_modules/.cache{,/**}"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Simteks-Tekstil-ERP-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Simteks Tekstil ERP"
    },
    "publish": {
      "provider": "generic",
      "url": "https://xzpmxdeteovwuqhjtasq.supabase.co/storage/v1/object/public/erp-desktop-updates/win"
    }
  }
}
